# Application Environment
NODE_ENV=production
PORT=4000
NEXT_TELEMETRY_DISABLED=1

# Branding & Public URL
NEXT_PUBLIC_APP_NAME=CryptoHub Institutional
NEXT_PUBLIC_APP_URL=http://localhost:4000

# Security & Session Authentication
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=generate-a-random-48-byte-hex-string-before-deploying

# Live Deposit Crypto Addresses (Displayed to users during deposits)
BTC_DEPOSIT_ADDRESS=bc1qxy2kgdygjrsqtzq2n0yrf2493p83kkfjhx0wlh
ETH_DEPOSIT_ADDRESS=0x71C8407BEA758B540306E5D73A9dFcf38914A690
USDT_DEPOSIT_ADDRESS=TXW29Zg3N8rR7Lq9n8rLkJH8zC41Q2K9mY

# Default Trader Account Profile
DEFAULT_USER_EMAIL=trader@cryptohub.io
DEFAULT_USER_NAME=Alex Sterling

# Referral Reward (credited to the REAL account only)
REFERRAL_REWARD_USD=5.00

# Supabase Credentials
NEXT_PUBLIC_SUPABASE_URL=https://jkwsadnqqsovsgqidvzo.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_BvESK8O88tLBnS0WBL5ZPw_fy2i4yYL
SUPABASE_PROJECT_REF=jkwsadnqqsovsgqidvzo

# Supabase Postgres connection string.
# The @ in the password MUST be percent-encoded as %40.
DATABASE_URL=postgresql://postgres:YOUR-ENCODED-PASSWORD@db.YOUR-PROJECT-REF.supabase.co:5432/postgres

# Server-only Supabase key used for durable writes. Optional: leave blank and
# the platform runs on its in-process store. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Display Currency
# USD -> KES rate used by the currency converter. Update to the live mid-rate.
USD_KES_RATE=129.50
NEXT_PUBLIC_DISPLAY_CURRENCY=KES