# ==============================================================================
# CRYPTOHUB TRADING PLATFORM - ENVIRONMENT VARIABLES
# Use these settings locally or paste them into your Render dashboard
# ==============================================================================

# Application Environment
NODE_ENV=production
PORT=10000
NEXT_TELEMETRY_DISABLED=1

# Branding & Public URL (Render will supply your https://cryptohub.onrender.com URL)
NEXT_PUBLIC_APP_NAME=CryptoHub Institutional
NEXT_PUBLIC_APP_URL=https://cryptohub.onrender.com

# Security & Session Authentication
JWT_SECRET=super_secret_jwt_key_replace_with_random_string_in_production

# Live Deposit Crypto Addresses (Displayed to users during deposits)
BTC_DEPOSIT_ADDRESS=bc1qxy2kgdygjrsqtzq2n0yrf2493p83kkfjhx0wlh
ETH_DEPOSIT_ADDRESS=0x71C8407BEA758B540306E5D73A9dFcf38914A690
USDT_DEPOSIT_ADDRESS=TXW29Zg3N8rR7Lq9n8rLkJH8zC41Q2K9mY

# Default Trader Account Profile
DEFAULT_USER_EMAIL=trader@cryptohub.io
DEFAULT_USER_NAME=Alex Sterling

# Optional External Database (if migrating from in-memory store to Postgres on Render)
# DATABASE_URL=postgresql://user:password@hostname:5432/dbname
